{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "webview-dist/**"]
    },
    "retune-vscode#build": {
      "dependsOn": ["^build", "@retune/webview#build"],
      "outputs": ["dist/**", "webview-dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {}
  }
}
